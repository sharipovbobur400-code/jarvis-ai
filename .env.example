# JARVIS AI Assistant - Environment Configuration Example
# Copy this file to .env or configure directly in JARVIS Settings UI

# Primary AI Provider (gemini | openai | anthropic | local)
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key (Optional fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local AI / Ollama URL (Optional offline fallback)
LOCAL_AI_URL=http://127.0.0.1:11434

# Voice & Assistant Defaults
JARVIS_USER_NAME=Bobur
JARVIS_DEFAULT_LANGUAGE=uz-UZ
JARVIS_VOICE_GENDER=female
JARVIS_VOICE_RATE=0.9
JARVIS_VOICE_PITCH=1.2

# Remote Server Config
REMOTE_SERVER_PORT=8888
REMOTE_PAIRING_SECRET=jarvis_secure_secret_token
