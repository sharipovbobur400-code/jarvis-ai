# JARVIS environment configuration — copy to `.env` and fill in.
# NEVER commit the real `.env` file.

# AI provider: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=YOUR_SECRET_KEY
AI_MODEL=gemini-1.5-flash

# Remote control server (Desktop side)
REMOTE_PORT=52000
REMOTE_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Voice
TTS_LANG_UZ=uz-UZ
TTS_LANG_RU=ru-RU
TTS_LANG_EN=en-US
